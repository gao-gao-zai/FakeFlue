    <string name="surface_tutorial_relearn_entry">Relearn the tutorial</string>
    <string name="surface_tutorial_intro">The tutorial runs in a preview and never switches modes or changes your real setup. Three guided lessons — hidden drawer, hidden menu and full settings, passcode reset — then one unguided practice round you must pass.</string>
